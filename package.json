{
  "name": "mcptester",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target portable",
    "portable:size": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target portable -SizeOptimized",
    "portable:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target portable -SkipBuild",
    "msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target msi",
    "msi:size": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target msi -SizeOptimized",
    "msi:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target msi -SkipBuild",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target all -Verify",
    "release:size": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target all -Verify -SizeOptimized",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target clean",
    "clean:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target clean -CleanMode full",
    "recompile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -Target rebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react18-json-view": "^0.2.10",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
